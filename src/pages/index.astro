---
import BaseLayout from '../layouts/BaseLayout.astro';
import resume from '../data/resume.json';
import type { ResumeData } from '../types/resume';
import HomeSkillBars from '../components/HomeSkillBars.vue';
import Icon from '../components/Icon.astro';

const data = resume as ResumeData;
const { basic } = data;

const base = import.meta.env.BASE_URL; // 部署基路径（Gitee Pages 为 /resume/）

const stats = [
  { label: '工作经验', value: `${basic.yearsExperience} 年` },
  { label: '项目案例', value: `${data.projects.length}+ 个` },
  { label: '技能分组', value: `${data.skills.length} 组` },
];

const featuredProjects = data.projects.slice(0, 2);
---

<BaseLayout title="首页" description={`${basic.name} 的个人主页 - ${basic.tagline}`}>
  <!-- Hero -->
  <section class="bg-gradient-to-br from-primary-100 via-white to-secondary-100">
    <div class="mx-auto flex max-w-5xl flex-col items-center gap-8 px-4 py-16 text-center sm:px-6 md:py-24">
      <div>
        <h1 class="text-3xl font-bold tracking-wide text-ink-900 sm:text-4xl">{basic.name}</h1>
        <p class="mt-3 inline-flex items-center gap-2 rounded-full bg-primary-500/10 px-4 py-1.5 text-sm font-medium text-primary-700">
          {basic.jobIntent}
        </p>
        <p class="mt-4 max-w-xl text-base leading-relaxed text-ink-600">{basic.tagline}</p>
        <div class="mt-3 flex flex-wrap items-center justify-center gap-4 text-sm text-ink-600">
          <span class="inline-flex items-center gap-1.5">
            <Icon name="mail" class="h-4 w-4 text-ink-400" />
            {basic.email}
          </span>
          <span class="inline-flex items-center gap-1.5">
            <Icon name="location" class="h-4 w-4 text-ink-400" />
            {basic.location}
          </span>
        </div>
      </div>
      <div class="flex flex-wrap items-center justify-center gap-3">
        <a
          href={`${base}resume`}
          class="rounded-full bg-primary-600 px-6 py-2.5 text-sm font-medium text-white shadow-md transition-colors hover:bg-primary-700"
        >
          查看简历
        </a>
        <a
          href={`${base}projects`}
          class="rounded-full border border-ink-400/30 bg-white px-6 py-2.5 text-sm font-medium text-ink-600 transition-colors hover:border-primary-400 hover:text-primary-600"
        >
          浏览项目
        </a>
      </div>

      <!-- 数据条 -->
      <div class="mt-4 flex w-full max-w-lg items-center justify-center gap-2 sm:gap-4">
        {stats.map((stat) => (
          <div class="flex-1 rounded-2xl border border-ink-400/15 bg-white/70 px-3 py-3 shadow-sm sm:px-4">
            <p class="text-lg font-bold text-primary-600 sm:text-xl">{stat.value}</p>
            <p class="mt-0.5 text-xs text-ink-400">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 关于我 -->
  <section class="mx-auto max-w-5xl px-4 py-14 sm:px-6">
    <div class="rounded-2xl border border-ink-400/15 bg-surface p-6 shadow-sm md:p-8">
      <h2 class="flex items-center gap-2 text-lg font-bold text-ink-900">
        <span class="h-5 w-1 rounded bg-primary-500"></span>
        关于我
      </h2>
      <p class="mt-4 text-sm leading-relaxed text-ink-600">{data.summary}</p>
    </div>
  </section>

  <!-- 技能概览 -->
  <section class="mx-auto max-w-5xl px-4 pb-14 sm:px-6">
    <div class="rounded-2xl border border-ink-400/15 bg-surface p-6 shadow-sm md:p-8">
      <h2 class="flex items-center gap-2 text-lg font-bold text-ink-900">
        <span class="h-5 w-1 rounded bg-primary-500"></span>
        技能概览
      </h2>
      <div class="mt-6">
        <HomeSkillBars groups={data.skills} client:visible />
      </div>
    </div>
  </section>

  <!-- 精选项目 -->
  <section class="mx-auto max-w-5xl px-4 pb-20 sm:px-6">
    <div class="flex items-center justify-between">
      <h2 class="flex items-center gap-2 text-lg font-bold text-ink-900">
        <span class="h-5 w-1 rounded bg-primary-500"></span>
        精选项目
      </h2>
      <a href={`${base}projects`} class="flex items-center gap-1 text-sm font-medium text-primary-600 hover:text-primary-700">
        查看全部
        <Icon name="arrow-right" class="h-4 w-4" />
      </a>
    </div>
    <div class="mt-6 grid gap-6 md:grid-cols-2">
      {featuredProjects.map((project) => (
        <a
          href={`${base}projects#${project.id}`}
          class="group rounded-2xl border border-ink-400/15 bg-surface p-6 shadow-sm transition-all hover:-translate-y-0.5 hover:shadow-md"
        >
          <div class="flex items-baseline justify-between gap-4">
            <h3 class="text-base font-bold text-ink-900 group-hover:text-primary-600">{project.name}</h3>
            <span class="shrink-0 text-xs text-ink-400">{project.start} - {project.end}</span>
          </div>
          <p class="mt-2 text-sm leading-relaxed text-ink-600">{project.description}</p>
          <div class="mt-4 flex flex-wrap gap-1.5">
            {project.techStack.slice(0, 4).map((tech) => (
              <span class="rounded-full bg-primary-50 px-2.5 py-0.5 text-xs text-primary-700">{tech}</span>
            ))}
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
