---
import type { SkillGroup } from '../types/resume';
import ResumeSection from './ResumeSection.astro';

interface Props {
  skills: SkillGroup[];
}

const { skills } = Astro.props;
---

<ResumeSection title="专业技能">
  <div class="space-y-3">
    {skills.map((group) => (
      <div class="avoid-break">
        <h3 class="mb-1.5 text-xs font-semibold text-primary-700">{group.group}</h3>
        <div class="grid grid-cols-1 gap-x-6 gap-y-1.5 sm:grid-cols-2">
          {group.items.map((item) => (
            <div class="flex items-center gap-2">
              <span class="w-36 shrink-0 truncate text-xs text-ink-600">{item.name}</span>
              <span class="h-1.5 flex-1 rounded-full bg-primary-100">
                <span
                  class="block h-full rounded-full bg-primary-500"
                  style={`width: ${item.level}%`}
                />
              </span>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</ResumeSection>
