---
import resume from '../data/resume.json';
import MobileMenu from './MobileMenu.vue';

const base = import.meta.env.BASE_URL; // 部署基路径（Gitee Pages 为 /resume/）

const links = [
  { href: `${base}`, label: '首页' },
  { href: `${base}resume`, label: '简历' },
  { href: `${base}projects`, label: '项目' },
];

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const navLinks = links.map((link) => ({
  ...link,
  active: pathname === link.href.replace(/\/$/, ''),
}));
---

<header class="sticky top-0 z-40 border-b border-ink-400/20 bg-white/80 backdrop-blur print:hidden">
  <nav class="mx-auto flex h-16 max-w-5xl items-center justify-between px-4 sm:px-6">
    <a href={`${import.meta.env.BASE_URL}`} class="flex items-center gap-2 text-sm font-bold text-ink-900">
      <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br from-primary-400 to-secondary-500 text-xs font-bold text-white">
        {resume.basic.name.charAt(0)}
      </span>
      <span class="hidden sm:inline">{resume.basic.name} · {resume.basic.jobIntent}</span>
    </a>

    <div class="hidden items-center gap-1 md:flex">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            'rounded-full px-4 py-2 text-sm font-medium transition-colors',
            link.active ? 'bg-primary-50 text-primary-600' : 'text-ink-600 hover:bg-ink-400/5',
          ]}
        >
          {link.label}
        </a>
      ))}
    </div>

    <MobileMenu links={navLinks} client:visible />
  </nav>
</header>
