---
import type { Education } from '../types/resume';

interface Props {
  items: Education[];
}

const { items } = Astro.props;
---

<div class="space-y-3">
  {items.map((item) => (
    <article class="avoid-break">
      <div class="flex items-baseline justify-between gap-4">
        <h3 class="text-sm font-bold text-ink-900">{item.school}</h3>
        <span class="shrink-0 text-xs text-ink-400">{item.start} - {item.end}</span>
      </div>
      <p class="mt-0.5 text-xs font-medium text-primary-600">{item.major} · {item.degree}</p>
      {item.note && <p class="mt-1 text-xs leading-relaxed text-ink-600">{item.note}</p>}
    </article>
  ))}
</div>
