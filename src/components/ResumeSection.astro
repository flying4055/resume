---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section class="mt-5">
  <h2 class="flex items-center gap-2 border-b border-ink-400/10 pb-1.5 text-base font-bold text-ink-900">
    <span class="h-4 w-1 rounded bg-primary-500"></span>
    {title}
  </h2>
  <div class="mt-3">
    <slot />
  </div>
</section>
